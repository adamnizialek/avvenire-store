DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=shop

# Set DB_SSL=true for hosted Postgres (Neon/Render). The server certificate is
# verified by default; only set DB_SSL_REJECT_UNAUTHORIZED=false if your
# provider's CA is genuinely unavailable.
DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true

# Opt-in schema sync for local dev only — it can ALTER/DROP columns. Ignored
# entirely when NODE_ENV=production: there the schema is managed by migrations
# (see README "Database migrations"). Prefer migrations even in dev.
DB_SYNCHRONIZE=false

# In production, pending migrations run automatically at boot. Set to false to
# opt out and run `npm run migration:run` manually instead. In dev, migrations
# only run at boot if you set this to true.
# DB_MIGRATIONS_RUN=true

NODE_ENV=development

JWT_SECRET=your-secret-key-change-me

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

FRONTEND_URL=http://localhost:5173

# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
RESEND_API_KEY=
MAIL_FROM=AVVENIRE <onboarding@resend.dev>
