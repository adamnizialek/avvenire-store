DB_USERNAME=postgres
DB_PASSWORD=change-me-in-production
DB_NAME=shop

# No migrations yet — the docker-compose stack sets this to true so a fresh DB
# gets its schema. Set to false once you adopt migrations.
DB_SYNCHRONIZE=true

JWT_SECRET=change-me-in-production

STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

FRONTEND_URL=https://yourdomain.com
VITE_API_URL=https://yourdomain.com/api

# The backend reads a single CLOUDINARY_URL (cloudinary://<key>:<secret>@<cloud_name>).
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

RESEND_API_KEY=re_...
MAIL_FROM=AVVENIRE <onboarding@resend.dev>
